# Copy this file to .env and fill in real values.
# .env is gitignored — never commit your key.

# --- Groq suggestion assistant ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Groq rotates its hosted models; if the default 404s, start the API
# and GET http://127.0.0.1:8001/api/chat/models to list ids your key can use.
# GROQ_MODEL=qwen/qwen3.8-27b

# --- YOLO weights ---
# Path to your trained poster detector checkpoint.
# Defaults to models/weights/best.pt when unset.
# MODEL_WEIGHTS=C:\path\to\best.pt

# --- Gaze engine (live webcam eye tracking) ---
# eth-xgaze (default, best across people and head poses) or mpiifacegaze.
# GAZE_ENGINE_MODE=eth-xgaze
# cpu or cuda
# GAZE_ENGINE_DEVICE=cpu
# Webcam horizontal field of view in degrees; typical laptop cameras are 60-80.
# GAZE_CAMERA_HFOV_DEG=70
# Accuracy bands judged on the held-out validation dots (screen pixels).
# GAZE_GOOD_MEDIAN_PX=100
# GAZE_FAIR_MEDIAN_PX=180

# --- Detection ---
# DETECTION_CONFIDENCE=0.25
# Same-class boxes overlapping more than this IoU are merged into one element.
# DETECTION_DUPLICATE_IOU=0.6

# --- Server limits and storage ---
# MAX_UPLOAD_MB=20
# CHAT_MAX_HISTORY_TURNS=12
# CHAT_RATE_LIMIT_PER_MINUTE=20
# ANALYSIS_DB_PATH=data/analyses.sqlite3
# ANALYSIS_DB_MAX_ROWS=200
# Prometheus metrics port (0 disables it).
# METRICS_PORT=8000
